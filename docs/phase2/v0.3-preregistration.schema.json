{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2 V0.3 preregistration",
  "description": "Closed: every object forbids unknown keys; the datasets' definitions, settings and input paths are constants; every hash is 64 hexadecimal digits; a data or target amendment needs its evidence and artifact hashes (rounds 73-74). Cross-field invariants: tools/validation/prereg.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "about",
    "version",
    "frozen_on",
    "amendments",
    "model",
    "error_model",
    "geometry",
    "datasets",
    "digitization",
    "criteria",
    "reporting"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "condition": {
      "type": "string",
      "pattern": "^(1|2|I|II)/[a-z0-9.]+$"
    },
    "label": {
      "enum": [
        "unresolved failure",
        "explained discrepancy",
        "pending",
        "partially supported",
        "experimentally supported"
      ]
    },
    "benzene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "couplings",
        "point_group",
        "conditions",
        "observations_per_condition",
        "nu",
        "ring_positions",
        "orbits",
        "estimands",
        "frame",
        "frame_map_matrix",
        "conversion_matrix",
        "roster_cells",
        "targets",
        "flags"
      ],
      "properties": {
        "couplings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "datasets/benzene-zli1132-taggar2006/couplings.csv"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "point_group": {
          "const": "D6h"
        },
        "conditions": {
          "const": 15
        },
        "observations_per_condition": {
          "const": 3
        },
        "nu": {
          "const": 2
        },
        "ring_positions": {
          "const": {
            "H1": 0,
            "H2": 60,
            "H3": 120,
            "H4": 180,
            "H5": 240,
            "H6": 300
          }
        },
        "orbits": {
          "const": {
            "D12": [
              "H1",
              "H2"
            ],
            "D13": [
              "H1",
              "H3"
            ],
            "D14": [
              "H1",
              "H4"
            ]
          }
        },
        "estimands": {
          "const": [
            "S_zz"
          ]
        },
        "frame": {
          "const": "V1 D6h (D-4): z along C6, normal to the ring; x along one C2'"
        },
        "frame_map_matrix": {
          "const": [
            [
              1,
              0,
              0
            ],
            [
              0,
              1,
              0
            ],
            [
              0,
              0,
              1
            ]
          ]
        },
        "conversion_matrix": {
          "const": [
            [
              1
            ]
          ]
        },
        "roster_cells": {
          "const": 15
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "form",
            "count",
            "pending"
          ],
          "properties": {
            "path": {
              "const": "datasets-local/benzene-taggar2006-targets/targets.csv"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "form": {
              "const": "table"
            },
            "count": {
              "const": 15
            },
            "pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            }
          }
        },
        "flags": {
          "const": {
            "co_solutes": [
              "1/mix1",
              "2/mix2.1",
              "2/mix2.2",
              "2/mix2.3"
            ],
            "shared_tube": "run 1 single-solute series"
          }
        }
      }
    },
    "odcb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "couplings",
        "point_group",
        "conditions",
        "observations_per_condition",
        "nu",
        "ring_positions",
        "orbits",
        "estimands",
        "frame",
        "frame_map_matrix",
        "conversion_matrix",
        "roster_cells",
        "targets",
        "flags"
      ],
      "properties": {
        "couplings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "const": "datasets-local/odcb-chandrakumar1993/couplings.csv"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "point_group": {
          "const": "C2v"
        },
        "conditions": {
          "const": 22
        },
        "observations_per_condition": {
          "const": 4
        },
        "nu": {
          "const": 2
        },
        "ring_positions": {
          "const": {
            "H1": 0,
            "H2": 60,
            "H3": 120,
            "H4": 180
          }
        },
        "orbits": {
          "const": {
            "D12=D34": [
              "H1",
              "H2"
            ],
            "D13=D24": [
              "H1",
              "H3"
            ],
            "D14": [
              "H1",
              "H4"
            ],
            "D23": [
              "H2",
              "H3"
            ]
          }
        },
        "estimands": {
          "const": [
            "S_zz",
            "S_xx-S_yy"
          ]
        },
        "frame": {
          "const": "paper: z normal to the ring, y the in-plane C2 axis, x parallel to H2-H3"
        },
        "frame_map_matrix": {
          "const": [
            [
              0,
              0,
              1
            ],
            [
              1,
              0,
              0
            ],
            [
              0,
              1,
              0
            ]
          ]
        },
        "conversion_matrix": {
          "const": [
            [
              -0.5,
              0.5
            ],
            [
              -1.5,
              -0.5
            ]
          ]
        },
        "roster_cells": {
          "const": 44
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "form",
            "count",
            "pending"
          ],
          "properties": {
            "path": {
              "const": "datasets-local/odcb-chandrakumar1993/targets.csv"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "form": {
              "const": "figure"
            },
            "count": {
              "const": 44
            },
            "pending": {
              "type": "integer",
              "minimum": 0,
              "maximum": 44
            }
          }
        },
        "flags": {
          "const": {
            "near_duplicate": [
              "II/300",
              "II/302"
            ],
            "co_solutes": [
              "II/300"
            ],
            "colon_tokens": "read as decimals (V0.2)",
            "transcription": "two identical AI transcriptions; owner spot-check pending"
          }
        }
      }
    }
  },
  "properties": {
    "about": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^prereg\\.[0-9]+$"
    },
    "frozen_on": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "amendments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "reason",
          "post_hoc",
          "protocol_before_sha256",
          "protocol_after_sha256"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "kind": {
            "enum": [
              "protocol",
              "data correction",
              "target correction"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "post_hoc": {
            "type": "boolean"
          },
          "protocol_before_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "protocol_after_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "artifact_path": {
            "type": "string",
            "pattern": "^(datasets|datasets-local)/(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
          },
          "artifact_before_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "artifact_after_sha256": {
            "$ref": "#/$defs/sha256"
          }
        },
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "data correction",
                "target correction"
              ]
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "required": [
            "evidence",
            "artifact_path",
            "artifact_before_sha256",
            "artifact_after_sha256"
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fit",
        "fixed_fit_version",
        "adequacy_alpha",
        "weak_rtol",
        "nuclide_table",
        "isotope",
        "motions",
        "medium",
        "per_condition"
      ],
      "properties": {
        "fit": {
          "const": "dipolar_core.fixed.fit_fixed"
        },
        "fixed_fit_version": {
          "const": "fixed-linear.1"
        },
        "adequacy_alpha": {
          "const": 0.001
        },
        "weak_rtol": {
          "const": 1e-06
        },
        "nuclide_table": {
          "const": "codata2018-iupac.1"
        },
        "isotope": {
          "const": "1H"
        },
        "motions": {
          "const": "none"
        },
        "medium": {
          "const": "achiral uniaxial"
        },
        "per_condition": {
          "const": true
        }
      }
    },
    "error_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "covariance",
        "secondary_descriptive",
        "paper_frame_errors"
      ],
      "properties": {
        "primary": {
          "const": "independent Gaussian, sigma as printed"
        },
        "covariance": {
          "type": "null"
        },
        "secondary_descriptive": {
          "const": "standard errors scaled by sqrt(chi2/nu)"
        },
        "paper_frame_errors": {
          "const": "the full fitted covariance, transformed by the conversion matrix"
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "r_cc_angstrom",
        "r_ch_angstrom",
        "shape"
      ],
      "properties": {
        "source": {
          "const": "Gauss and Stanton, J. Phys. Chem. A 104, 2865 (2000), r_e"
        },
        "r_cc_angstrom": {
          "const": 1.3914
        },
        "r_ch_angstrom": {
          "const": 1.0802
        },
        "shape": {
          "const": "planar regular hexagon, radial C-H"
        }
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benzene-taggar2006",
        "odcb-chandrakumar1993"
      ],
      "properties": {
        "benzene-taggar2006": {
          "$ref": "#/$defs/benzene"
        },
        "odcb-chandrakumar1993": {
          "$ref": "#/$defs/odcb"
        }
      }
    },
    "digitization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_figure",
        "cross_check_figure",
        "match_tolerance_T_r",
        "fig2_match_kelvin",
        "fig2_disagreement_factor"
      ],
      "properties": {
        "primary_figure": {
          "const": "Fig. 3"
        },
        "cross_check_figure": {
          "const": "Fig. 2"
        },
        "match_tolerance_T_r": {
          "const": 0.0015
        },
        "fig2_match_kelvin": {
          "const": 1
        },
        "fig2_disagreement_factor": {
          "const": 2
        }
      }
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent",
        "reproduction",
        "eligibility",
        "label_precedence",
        "sensitivity"
      ],
      "properties": {
        "independent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "relative_tolerance",
            "precision_factor",
            "S_zz_margin",
            "S_xx-S_yy_margin"
          ],
          "properties": {
            "label": {
              "const": "independent support (declared geometry)"
            },
            "relative_tolerance": {
              "const": 0.05
            },
            "precision_factor": {
              "const": 2
            },
            "S_zz_margin": {
              "const": "relative_tolerance * |S_zz,pub| + precision_factor * p"
            },
            "S_xx-S_yy_margin": {
              "const": "relative_tolerance * |S_zz,pub| + precision_factor * p (an axial-scale heuristic)"
            }
          }
        },
        "reproduction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "requires",
            "table_margin",
            "figure_margin",
            "fallback_label"
          ],
          "properties": {
            "label": {
              "const": "reproduction (the authors' analysis)"
            },
            "requires": {
              "const": [
                "geometry",
                "objective",
                "weights",
                "corrections"
              ]
            },
            "table_margin": {
              "const": "max(printed sigma, half a unit in the last printed digit)"
            },
            "figure_margin": {
              "const": "precision_factor * p"
            },
            "fallback_label": {
              "const": "approximate reproduction (assumed weights 1/sigma^2)"
            }
          }
        },
        "eligibility": {
          "const": [
            "rank-unverified",
            "no-target",
            "s_zz-target-pending"
          ]
        },
        "label_precedence": {
          "const": [
            "unresolved failure",
            "explained discrepancy",
            "pending",
            "partially supported",
            "experimentally supported"
          ]
        },
        "sensitivity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "odcb-chandrakumar1993"
          ],
          "properties": {
            "odcb-chandrakumar1993": {
              "const": [
                "II/300",
                "II/302"
              ]
            }
          }
        }
      }
    },
    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disclosure",
        "spot_check_gating"
      ],
      "properties": {
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amendment",
            "shared",
            "discrepancy_entry_names",
            "discrepancy_entry_context",
            "discrepancy_entry_excludes"
          ],
          "properties": {
            "amendment": {
              "const": "P-1"
            },
            "shared": {
              "const": "prereg.shareable"
            },
            "discrepancy_entry_names": {
              "const": [
                "dataset",
                "track",
                "condition",
                "estimand",
                "protocol_sha256"
              ]
            },
            "discrepancy_entry_context": {
              "const": [
                "estimand",
                "frame and observable convention",
                "geometry",
                "vibrational corrections",
                "solvent and sample",
                "suspected cause"
              ]
            },
            "discrepancy_entry_excludes": {
              "const": [
                "target",
                "fit",
                "signed difference",
                "margin",
                "ratio"
              ]
            }
          }
        },
        "spot_check_gating": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amendment",
            "rule",
            "tracks",
            "keeps_precedence"
          ],
          "properties": {
            "amendment": {
              "const": "P-2"
            },
            "rule": {
              "const": "targets absent (no-target) until the dataset's spot-check receipt is signed, bound to the checked file's SHA-256"
            },
            "tracks": {
              "const": [
                "independent",
                "reproduction"
              ]
            },
            "keeps_precedence": {
              "const": "rank-unverified"
            }
          }
        }
      },
      "description": "V0.3 amendments P-1 and P-2 (2026-11-21), as closed fields so that the protocol revision changes with them (round 81, A7)."
    }
  }
}
